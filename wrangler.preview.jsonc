{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zudo-case-preview",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "zudo-case-preview.zudolab.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist-preview",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/previews/r6-body.html",
      "/downloads/archive/r7-m3-lid-source.zip"
    ]
  }
}
