{
  "name": "zudo-case-doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:r9": "node scripts/lib/r9-manifest-check.mjs",
    "check:r9-doc-table": "node scripts/sync-r9-doc-table.mjs --check",
    "check:r9-confirm": "node scripts/check-r9-confirm.mjs",
    "check:r9-ledger": "node scripts/sync-r9-ledger.mjs --check",
    "test:r9": "node --test tests/r9-manifest-check.test.mjs",
    "check:built-preview-links": "node scripts/check-built-preview-links.mjs",
    "check:tables": "node scripts/sync-reference-tables.mjs --check",
    "check:assets": "node scripts/verify-assets.mjs",
    "sync:tables": "node scripts/sync-reference-tables.mjs",
    "sync:r9-ledger": "node scripts/sync-r9-ledger.mjs",
    "test:setup": "node --test tests/setup.test.mjs",
    "dev": "node scripts/run-site.mjs dev",
    "build": "node scripts/run-site.mjs build",
    "preview": "node scripts/run-site.mjs preview",
    "check": "node scripts/run-site.mjs check",
    "check:links": "node scripts/check-links.js",
    "check:images": "zudo-doc check images",
    "prepare:worker-assets": "node scripts/prepare-worker-assets.mjs",
    "verify:deployed": "node scripts/verify-deployed-assets.mjs",
    "deploy:docs": "wrangler deploy --config wrangler.docs.jsonc",
    "deploy:preview": "wrangler deploy --config wrangler.preview.jsonc",
    "test:ledger": "node --test tests/ledger-*.test.mjs",
    "check:fitfix": "node scripts/sync-fitfix.mjs --check",
    "sync:fitfix": "node scripts/sync-fitfix.mjs",
    "check:lid-m5": "node scripts/sync-lid-m5.mjs --check",
    "sync:lid-m5": "node scripts/sync-lid-m5.mjs",
    "check:fit-test-order": "python3 scripts/prepare-fit-test-order.py --check",
    "build:two-way": "node engineering/two-way/tw-01/build.cjs",
    "check:two-way": "node engineering/two-way/tw-01/build.cjs --check",
    "test:two-way": "node --test engineering/two-way/tw-01/tests/*.test.cjs",
    "test:two-way:browser": "node engineering/two-way/tw-01/tests/browser.cjs",
    "check:preview-isolation": "node --test tests/real-cli/preview-isolation.test.mjs",
    "check:wind": "zfb wind audit --fail-on error",
    "build:fullset": "uv run --locked --project engineering/r9-prototype-01 python engineering/r10-fullset-01/build.py",
    "build:home-washers": "uv run --locked --project engineering/r9-prototype-01 python engineering/r10-fullset-01/build.py --washers-only --out .cache/r10-home-washers",
    "sync:fullset": "node scripts/sync-fullset.mjs",
    "check:fullset": "node scripts/sync-fullset.mjs --check",
    "test:fullset": "python3 engineering/r10-fullset-01/tests/test_contract.py",
    "build:printed-5mm": "uv run --locked --project engineering/printed-5mm/p3 python engineering/printed-5mm/p3/build.py --out .cache/printed-5mm-build",
    "check:printed-5mm": "node scripts/check-printed-5mm.mjs",
    "test:printed-5mm": "node --test tests/printed-5mm.test.mjs"
  },
  "dependencies": {
    "@takazudo/zfb": "4.5.0",
    "@takazudo/zfb-md-wasm": "4.5.0",
    "@takazudo/zfb-runtime": "4.5.0",
    "@takazudo/zudo-doc": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@takazudo/zudo-doc-history-server": "6.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "wrangler": "4.138.0"
  },
  "packageManager": "pnpm@10.30.3"
}
