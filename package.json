{
  "name": "zudo-case-doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:r9": "node scripts/lib/r9-manifest-check.mjs",
    "check:r9-doc-table": "node scripts/sync-r9-doc-table.mjs --check",
    "check:r9-confirm": "node scripts/check-r9-confirm.mjs",
    "check:r9-ledger": "node scripts/sync-r9-ledger.mjs --check",
    "test:r9": "node --test tests/r9-manifest-check.test.mjs",
    "check:built-preview-links": "node scripts/check-built-preview-links.mjs",
    "check:tables": "node scripts/sync-reference-tables.mjs --check",
    "check:assets": "node scripts/verify-assets.mjs",
    "sync:tables": "node scripts/sync-reference-tables.mjs",
    "sync:r9-ledger": "node scripts/sync-r9-ledger.mjs",
    "test:setup": "node --test tests/setup.test.mjs",
    "dev": "node scripts/run-site.mjs dev",
    "build": "node scripts/run-site.mjs build",
    "preview": "node scripts/run-site.mjs preview",
    "check": "node scripts/run-site.mjs check",
    "check:links": "node scripts/check-links.js",
    "check:images": "zudo-doc check images",
    "prepare:worker-assets": "node scripts/prepare-worker-assets.mjs",
    "verify:deployed": "node scripts/verify-deployed-assets.mjs",
    "deploy:docs": "wrangler deploy --config wrangler.docs.jsonc",
    "deploy:preview": "wrangler deploy --config wrangler.preview.jsonc",
    "test:ledger": "node --test tests/ledger-*.test.mjs"
  },
  "dependencies": {
    "@takazudo/zfb": "2.20.2",
    "@takazudo/zfb-md-wasm": "2.20.2",
    "@takazudo/zfb-runtime": "2.20.2",
    "@takazudo/zudo-doc": "^5.27.0",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@takazudo/zudo-doc-history-server": "5.27.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "wrangler": "4.138.0"
  }
}
